# WebUntis instance (required)
# Server host and school login name, e.g. from the school search or the QR code
UNTIS_BASE_URL=https://yourschool.webuntis.com
UNTIS_SCHOOL=yourschool

# Login – EITHER the Untis Mobile app secret (works for SSO accounts) ...
# WebUntis → profile → "Freigaben"/"Sharing" → Untis Mobile → show QR code / secret.
# The QR code encodes: untis://setschool?url=…&school=…&user=…&key=<SECRET>
UNTIS_USERNAME=
UNTIS_APP_SECRET=
# ... or the whole QR code URL instead of the three values above:
# UNTIS_QR_URL=untis://setschool?url=…&school=…&user=…&key=…
# ... OR a native WebUntis password (not available for pure SSO accounts):
# UNTIS_PASSWORD=
# Docker secrets: UNTIS_APP_SECRET_FILE, UNTIS_QR_URL_FILE, UNTIS_PASSWORD_FILE

# Transport: stdio (default, local clients) | http (Streamable HTTP at /mcp)
MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1      # Docker image: 0.0.0.0
# MCP_PORT=3000
# MCP_API_KEY=            # required for http, at least 32 characters
# MCP_ALLOWED_ORIGINS=

# Persistence (pseudonym secret, teacher directory, file cache)
DATA_DIR=.data

# Redaction
# REDACTION_LANGUAGE=de           # de | en
# REDACT_TEACHERS=false           # true → pseudonymise teachers as well
# KEEP_TEACHER_ABBREVIATIONS=true # false → drop teacher abbreviations (e.g. "MÜL")
# REDACTION_KEEP_WORDS=

# Optional
# CACHE_TTL_S=60
# MAX_CONCURRENCY=2
# MIN_REQUEST_INTERVAL_MS=200
# LOG_LEVEL=info
